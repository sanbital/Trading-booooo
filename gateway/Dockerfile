FROM node:22-alpine
WORKDIR /app
COPY server.mjs ./server.mjs
COPY venue-read-flight.mjs ./venue-read-flight.mjs
COPY scheduler-orchestrator.mjs ./scheduler-orchestrator.mjs
COPY scheduler-repository.mjs ./scheduler-repository.mjs
COPY order-writer-fence.mjs ./order-writer-fence.mjs
COPY futures-mode-evidence.mjs ./futures-mode-evidence.mjs
COPY v17-stop-commands.mjs ./v17-stop-commands.mjs
COPY v17-shadow-worker.mjs ./v17-shadow-worker.mjs
COPY v17-shadow-host.mjs ./v17-shadow-host.mjs
# Generated by stage-engine.mjs at deploy time and git-ignored, so the exit engine has
# exactly one committed copy (supabase/functions/_shared) and cannot drift from the one
# the executor runs. The build fails loudly if staging was skipped.
COPY leader-exit-r3.mjs ./leader-exit-r3.mjs
COPY leader-exit-r4.mjs ./leader-exit-r4.mjs
RUN chmod 644 /app/*.mjs
ARG RELEASE_COMMIT=unknown
ENV RELEASE_COMMIT=$RELEASE_COMMIT
ENV NODE_ENV=production PORT=8080
USER node
EXPOSE 8080
CMD ["node", "server.mjs"]
