{
  "imports": {
    "https://deno.land/std@0.224.0/assert/mod.ts": "./test-support/assert.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "include": [
      "backtest/**/*.ts",
      "supabase/functions/market-scanner/**/*.ts",
      "supabase/functions/market-learning/**/*.ts",
      "supabase/functions/market-autotrader/**/*.ts",
      "supabase/functions/market-performance/**/*.ts",
      "supabase/functions/lob-calibration/**/*.ts",
      "supabase/functions/market-v2-signal/**/*.ts"
    ]
  },
  "tasks": {
    "check": "deno check supabase/functions/market-scanner/index.ts supabase/functions/market-learning/index.ts supabase/functions/market-autotrader/index.ts supabase/functions/market-performance/index.ts supabase/functions/lob-calibration/index.ts supabase/functions/market-v2-signal/index.ts backtest/run.ts backtest/calibrate.ts",
    "test": "deno test --allow-read supabase/functions/market-scanner/*.test.ts supabase/functions/market-autotrader/*.test.ts supabase/functions/market-performance/*.test.ts supabase/functions/_shared/*.test.ts supabase/functions/_shared/scalp/*.test.ts supabase/functions/_shared/lob/*.test.ts backtest/*.test.ts",
    "backtest": "deno run -A backtest/run.ts",
    "calibrate": "deno run -A backtest/calibrate.ts --write-profile"
  }
}
