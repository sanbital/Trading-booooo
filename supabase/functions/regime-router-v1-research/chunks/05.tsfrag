key,split");return json({ok:true,job_id:job.id,shard,markets:markets.length,success,failed});}

async function finalize(body:any){const job=await loadJob(String(body.job_id||""));const rows=await rest(`v2_research_market_results?job_id=eq.${encodeURIComponent(job.id)}&config_key=eq.BREADTH_SHARD&select=market,parameters&limit=100`);const shardCount=finite(job.config.shard_count,25);if((rows||[]).length<shardCount)throw new Error(`breadth shards incomplete ${(rows||[]).length}/${shardCount}`);const N=finite(job.config.grid_length),gridStart=finite(job.config.grid_start_ms);const valid6=new Array(N).fill(0),pos6=new Array(N).fill(0),sum6=new Array(N).fill(0),valid24=new Array(N).fill(0),pos24=new Array(N).fill(0),sum24=new Array(N).fill(0);for(const row of rows){const p=row.parameters||{};for(let i=0;i<N;i++){valid6[i]+=finite(p.valid6?.[i]);pos6[i]+=finite(p.pos6?.[i]);sum6[i]+=finite(p.sum6?.[i]);valid24[i]+=finite(p.valid24?.[i]);pos24[i]+=finite(p.pos24?.[i]);sum24[i]+=finite(p.sum24?.[i]);}}
  const btc=await bars("BTCUSDT",Date.parse(job.window_start),Date.parse(job.window_end));const bm=new Map<number,number>();for(const b of btc)bm.set(b.time,b.close);const rawB=new Array(N).fill(false),rawS=new Array(N).fill(false),codes=new Array(N).fill("U");const total=finite(job.total_markets);for(let i=0;i<N;i++){const t=gridStart+i*BAR_MS;if(valid24[i]<Math.max(50,total*0.25))continue;const b6=valid6[i]?pos6[i]/valid6[i]:0,b24=valid24[i]?pos24[i]/valid24[i]:0,mean24=valid24[i]?sum24[i]/valid24[i]:0;const now=bm.get(t),p6=bm.get(t-24*BAR_MS),p24=bm.get(t-96*BAR_MS);if(!now||!p6||!p24)continue;const btc6=now/p6-1,btc24=now/p24-1;rawB[i]=b24>=0.58&&b6>=0.55&&mean24>0&&btc24>0&&btc6>-0.01;rawS[i]=b24<=0.42&&b6<=0.45&&mean24<0&&btc24<0&&btc6<0.01;let cb=0,cs=0;for(let j=Math.max(0,i-3);j<=i;j++){if(rawB[j])cb++;if(rawS[j])cs++;}codes[i]=cb>=3?"B":cs>=3?"S":"R";}
  const counts={BULL:codes.filter(x=>x==="B").length,RANGE:codes.filter(x=>x==="R").length,BEAR:codes.filter(x=>x==="S").length,UNKNOWN:codes.filter(x=>x==="U").length};const splitTime=gridStart+Math.floor(N*0.70)*BAR_MS;await patchJob(job.id,{status:"RUNNING",started_at:job.started_at||new Date().toISOString(),metrics:{phase:"BACKTEST",grid_start_ms:gridStart,grid_length:N,regime_codes:codes.join(""),regime_counts:counts,split_time_ms:splitTime,breadth_shards:rows.length,finalized_at:new Date().toISOString()}});return json({ok:true,job_id:job.id,regime_counts:counts,split_time:new Date(splitTime).toISOString()});}

async function backtestShard(body:any){const job=await loadJob(String(body.job_id||""));if(!job.metrics?.regime_codes)throw new Error("finalize first");const shardCount=Math.max(1,Math.round(finite(body.shard_count,job.config?.shard_count||25))),shard=Math.round(finite(body.shard_index,-1));if(shard<0||shard>=shardCount)throw new Error("bad shard");const markets=(job.config.markets as string[]).filter((_:string,i:number)=>i%shardCount===shard),start=Date.parse(job.window_start),end=Date.parse(job.window_end),splitTime=finite(job.metrics.split_time_ms);const fetched=await mapConcurrent(markets,4,async market=>{try{return {market,ok:true as const,b:await bars(market,start,end)}}catch(e){return {market,ok:false as const,error:e instanceof Error?e.message:String(e)}}});const rows:any[]=[];let success=0,failed=0;for(const f of fetched){if(!f.ok||f.b.length<300){failed++;continue;}success++;const p=prepare(f.b);for(const c of candidates()){const sim=simulateMarket(p,job.metrics,c,splitTime);rows.push(metricRow(job,f.market,c,"IS",summarize(sim.IS),p.length,p[0]?.time||0,p.at(-1)?.time||0));rows.push(metricRow(job,f.market,c,"OOS",summarize(sim.OOS),p.length,p[0]?.time||0,p.at(-1)?.time||0));}}if(rows.length)await upsertRows("v2_research_market_results",rows,"job_id,market,config_key,split");return json({ok:true,job_id:job.id,shard,markets:markets.length,success,failed,result_rows:rows.length});}

async function complete(body:any){const job=await loadJob(String(body.job_id||""));const rows=await rest(`v2_research_market_results?job_id=eq.${encodeURIComponent(job.id)}&split=eq.OOS&select=market&limit=20000`);const unique=new Set((rows||[]).map((x:any)=>x.market));const updated=await patchJob(job.id,{status:"COMPLETE",processed_markets:unique.size,completed_at:new Date().toISOString(),metrics:{...(job.metrics||{}),phase:"COMPLETE",completed_at:new Date().toISOString()}});return json({ok:true,job_id:job.id,status:updated.status,processed_markets:unique.size});}
async function jobStatus(body:any){const job=await loadJob(String(body.job_id||""));return json({ok:true,job});}

Deno.serve(async(req:Request)=>{const started=Date.now();try{if(req.method!=="POST")return json({ok:false,error:"POST required"},405);if(!await authorize(req))return json({ok:false,error:"un