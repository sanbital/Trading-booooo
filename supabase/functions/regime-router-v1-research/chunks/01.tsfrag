function ema(xs:number[],period:number){const out=new Array(xs.length).fill(NaN);if(!xs.length)return out;const a=2/(period+1);let v=xs[0];out[0]=v;for(let i=1;i<xs.length;i++){v=xs[i]*a+v*(1-a);out[i]=v;}return out;}
function wilder(xs:number[],period:number){const out=new Array(xs.length).fill(NaN);if(!xs.length)return out;let v=xs[0];out[0]=v;for(let i=1;i<xs.length;i++){v=(v*(period-1)+xs[i])/period;out[i]=v;}return out;}
function rollingMax(xs:number[],n:number,i:number){let v=-Infinity;for(let j=Math.max(0,i-n+1);j<=i;j++)v=Math.max(v,xs[j]);return v;}
function rollingMin(xs:number[],n:number,i:number){let v=Infinity;for(let j=Math.max(0,i-n+1);j<=i;j++)v=Math.min(v,xs[j]);return v;}
function rollingMean(xs:number[],n:number,i:number){let s=0,c=0;for(let j=Math.max(0,i-n+1);j<=i;j++){if(Number.isFinite(xs[j])){s+=xs[j];c++;}}return c?s/c:NaN;}
function rollingStd(xs:number[],n:number,i:number){const m=rollingMean(xs,n,i);if(!Number.isFinite(m))return NaN;let s=0,c=0;for(let j=Math.max(0,i-n+1);j<=i;j++){if(Number.isFinite(xs[j])){s+=(xs[j]-m)**2;c++;}}return c?Math.sqrt(s/c):NaN;}
function rsiSeries(closes:number[],n=14){const g=new Array(closes.length).fill(0),l=new Array(closes.length).fill(0);for(let i=1;i<closes.length;i++){const d=closes[i]-closes[i-1];g[i]=Math.max(d,0);l[i]=Math.max(-d,0);}const ag=wilder(g,n),al=wilder(l,n);return closes.map((_,i)=>al[i]===0?(ag[i]===0?50:100):100-100/(1+ag[i]/al[i]));}

