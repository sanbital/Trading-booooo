set==="USDT")
    .map((x:any)=>String(x.symbol||"" )).filter(Boolean).sort();
}
function toBar(x:any[]):Bar { return {time:finite(x?.[0]),open:finite(x?.[1]),high:finite(x?.[2]),low:finite(x?.[3]),close:finite(x?.[4]),volume:finite(x?.[5]),quoteVolume:finite(x?.[7])}; }
async function bars(market:string,start:number,end:number):Promise<Bar[]> {
  const out:Bar[]=[]; let cursor=start;
  for(let page=0; cursor<=end && page<6; page++) {
    const u=`${BINANCE}/fapi/v1/klines?symbol=${encodeURIComponent(market)}&interval=15m&startTime=${cursor}&endTime=${end}&limit=1000`;
    const payload=await fetchJson(u);
    const rows=(Array.isArray(payload)?payload:[]).map(toBar).filter((b:Bar)=>b.time>=start&&b.time<=end&&b.close>0);
    if(!rows.length) break; out.push(...rows);
    const next=rows[rows.length-1].time+BAR_MS; if(next<=cursor)break; cursor=next; if(rows.length<1000)break;
  }
  const m=new Map<number,Bar>(); for(const b of out)m.set(b.time,b); return [...m.values()].sort((a,b)=>a.time-b.time);
}
async function mapConcurrent<T,R>(items:T[], concurrency:number, fn:(v:T)=>Promise<R>):Promise<R[]> {
  const res=new Array<R>(items.length); let cursor=0;
  const workers=Array.from({length:Math.min(concurrency,items.length)},async()=>{while(true){const i=cursor++;if(i>=items.length)return;res[i]=await fn(items[i]);}});
  await Promise.all(workers); return res;
}

