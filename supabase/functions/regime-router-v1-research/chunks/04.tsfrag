.reduce((a,b)=>a+b,0),mean:ts.length?nets.reduce((a,b)=>a+b,0)/ts.length:0,median,pf:gl>0?gp/gl:(gp>0?null:0),maxDD:dd,avgMfe:ts.length?ts.reduce((a,b)=>a+b.mfe,0)/ts.length:0,avgMae:ts.length?ts.reduce((a,b)=>a+b.mae,0)/ts.length:0,avgHold:ts.length?ts.reduce((a,b)=>a+b.hold,0)/ts.length:0,targetHits:ts.filter(t=>t.reason==="TARGET").length,stopHits:ts.filter(t=>t.reason==="STOP").length,timeExits:ts.filter(t=>!["TARGET","STOP"].includes(t.reason)).length,captureSum:captures.reduce((a,b)=>a+b,0),captureCount:captures.length,givebackSum:ts.reduce((a,b)=>a+b.giveback,0)};}

function metricRow(job:any,market:string,c:Candidate,split:string,m:any,barCount:number,first:number,last:number){return {job_id:job.id,revision:REVISION,venue:"binance_futures",market,config_key:c.name,family:c.kind,side:c.side,regime:c.regime,split,bars:barCount,first_bar_at:first?new Date(first).toISOString():null,last_bar_at:last?new Date(last).toISOString():null,trades:m.trades,wins:m.wins,losses:m.losses,win_rate:m.winRate,gross_profit_bps:m.gp,gross_loss_bps:m.gl,net_bps:m.net,stress_net_bps:m.stress,mean_net_bps:m.mean,median_net_bps:m.median,profit_factor:m.pf,max_drawdown_bps:m.maxDD,average_mfe_bps:m.avgMfe,average_mae_bps:m.avgMae,average_hold_bars:m.avgHold,target_hits:m.targetHits,stop_hits:m.stopHits,time_exits:m.timeExits,parameters:{...c,capture_sum:m.captureSum,capture_count:m.captureCount,giveback_sum_bps:m.givebackSum},updated_at:new Date().toISOString()};}
function zeroShardRow(job:any,market:string,params:any){return {job_id:job.id,revision:REVISION,venue:"binance_futures",market,config_key:"BREADTH_SHARD",family:"BREADTH_SHARD",side:"BOTH",regime:"DYNAMIC",split:"SHARD",bars:0,first_bar_at:null,last_bar_at:null,trades:0,wins:0,losses:0,win_rate:0,gross_profit_bps:0,gross_loss_bps:0,net_bps:0,stress_net_bps:0,mean_net_bps:0,median_net_bps:0,profit_factor:null,max_drawdown_bps:0,average_mfe_bps:0,average_mae_bps:0,average_hold_bars:0,target_hits:0,stop_hits:0,time_exits:0,parameters:params,updated_at:new Date().toISOString()};}

async function start(body:any){const lookback=Math.max(20,Math.min(45,Math.round(finite(body?.lookback_days,30))));const markets=await universe();const end=Math.floor(Date.now()/BAR_MS)*BAR_MS-BAR_MS;const start=end-lookback*86_400_000;const gridStart=Math.ceil(start/BAR_MS)*BAR_MS;const gridEnd=end;const gridLength=Math.floor((gridEnd-gridStart)/BAR_MS)+1;const job=await insertJob({revision:REVISION,venue:"binance_futures",bar_interval:"15m",lookback_days:lookback,window_start:new Date(gridStart).toISOString(),window_end:new Date(gridEnd).toISOString(),status:"PENDING",cursor:0,total_markets:markets.length,processed_markets:0,failed_markets:0,config:{markets,grid_start_ms:gridStart,grid_end_ms:gridEnd,grid_length:gridLength,shard_count:25,split:0.70,cost_bps:BASE_COST_BPS,stress_cost_bps:STRESS_COST_BPS,source:"BINANCE_USDT_PERPETUAL_FULL_ACTIVE_UNIVERSE_15M"},metrics:{phase:"BREADTH"}});return json({ok:true,job_id:job.id,total_markets:markets.length,grid_length:gridLength});}

async function breadthShard(body:any){const job=await loadJob(String(body.job_id||""));if(job.revision!==REVISION)throw new Error("revision mismatch");const shardCount=Math.max(1,Math.round(finite(body.shard_count,job.config?.shard_count||25))),shard=Math.round(finite(body.shard_index,-1));if(shard<0||shard>=shardCount)throw new Error("bad shard");const markets=(job.config.markets as string[]).filter((_:string,i:number)=>i%shardCount===shard);const start=Date.parse(job.window_start),end=Date.parse(job.window_end),gridStart=finite(job.config.grid_start_ms),N=finite(job.config.grid_length);const valid6=new Array(N).fill(0),pos6=new Array(N).fill(0),sum6=new Array(N).fill(0),valid24=new Array(N).fill(0),pos24=new Array(N).fill(0),sum24=new Array(N).fill(0);let success=0,failed=0;
  const results=await mapConcurrent(markets,4,async market=>{try{return {market,ok:true as const,b:await bars(market,start,end)}}catch(e){return {market,ok:false as const,error:e instanceof Error?e.message:String(e)}}});
  for(const r of results){if(!r.ok){failed++;continue;}success++;const m=new Map<number,number>();for(const x of r.b)m.set(x.time,x.close);for(const x of r.b){const idx=Math.round((x.time-gridStart)/BAR_MS);if(idx<0||idx>=N)continue;const c6=m.get(x.time-24*BAR_MS),c24=m.get(x.time-96*BAR_MS);if(c6&&c6>0){const z=x.close/c6-1;valid6[idx]++;if(z>0)pos6[idx]++;sum6[idx]+=Math.max(-0.2,Math.min(0.2,z));}if(c24&&c24>0){const z=x.close/c24-1;valid24[idx]++;if(z>0)pos24[idx]++;sum24[idx]+=Math.max(-0.2,Math.min(0.2,z));}}}
  await upsertRows("v2_research_market_results",[zeroShardRow(job,`__BREADTH_${String(shard).padStart(2,"0")}__`,{shard,shard_count:shardCount,success,failed,valid6,pos6,sum6,valid24,pos24,sum24})],"job_id,market,config_