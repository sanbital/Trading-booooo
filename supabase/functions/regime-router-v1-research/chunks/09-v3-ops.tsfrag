
function v3MetricRow(job:any,market:string,c:Candidate,split:V3Split,m:any,barCount:number,first:number,last:number){return {job_id:job.id,revision:V3_REVISION,venue:"binance_futures",market,config_key:c.name,family:c.kind,side:c.side,regime:c.regime,split,bars:barCount,first_bar_at:first?new Date(first).toISOString():null,last_bar_at:last?new Date(last).toISOString():null,trades:m.trades,wins:m.wins,losses:m.losses,win_rate:m.winRate,gross_profit_bps:m.gp,gross_loss_bps:m.gl,net_bps:m.net,stress_net_bps:m.stress,mean_net_bps:m.mean,median_net_bps:m.median,profit_factor:m.pf,max_drawdown_bps:m.maxDD,average_mfe_bps:m.avgMfe,average_mae_bps:m.avgMae,average_hold_bars:m.avgHold,target_hits:m.targetHits,stop_hits:m.stopHits,time_exits:m.timeExits,parameters:{...c,capture_sum:m.captureSum,capture_count:m.captureCount,giveback_sum_bps:m.givebackSum,router_revision:V3_REVISION},updated_at:new Date().toISOString()};}
function v3BreadthRow(job:any,shard:number,params:any){return {job_id:job.id,revision:V3_REVISION,venue:"binance_futures",market:`__BREADTH_V3_${String(shard).padStart(2,"0")}__`,config_key:"BREADTH_SHARD_V3",family:"BREADTH_SHARD",side:"BOTH",regime:"DYNAMIC",split:"TRAIN",bars:0,first_bar_at:null,last_bar_at:null,trades:0,wins:0,losses:0,win_rate:0,gross_profit_bps:0,gross_loss_bps:0,net_bps:0,stress_net_bps:0,mean_net_bps:0,median_net_bps:0,profit_factor:null,max_drawdown_bps:0,average_mfe_bps:0,average_mae_bps:0,average_hold_bars:0,target_hits:0,stop_hits:0,time_exits:0,parameters:{shard,...params},updated_at:new Date().toISOString()};}
async function startV3(body:any){const lookback=Math.max(30,Math.min(60,Math.round(finite(body?.lookback_days,45))));const markets=await universe();const end=Math.floor(Date.now()/BAR_MS)*BAR_MS-BAR_MS;const start=end-lookback*86_400_000;const gridStart=Math.ceil(start/BAR_MS)*BAR_MS,gridEnd=end,gridLength=Math.floor((gridEnd-gridStart)/BAR_MS)+1;const job=await insertJob({revision:V3_REVISION,venue:"binance_futures",bar_interval:"1h",lookback_days:lookback,window_start:new Date(gridStart).toISOString(),window_end:new Date(gridEnd).toISOString(),status:"PENDING",cursor:0,total_markets:markets.length,processed_markets:0,failed_markets:0,config:{markets,actual_bar_interval:"15m",grid_start_ms:gridStart,grid_end_ms:gridEnd,grid_length:gridLength,shard_count:25,training_split:.60,validation_split:.20,test_split:.20,cost_bps:BASE_COST_BPS,stress_cost_bps:STRESS_COST_BPS,source:"BINANCE_USDT_PERPETUAL_FULL_ACTIVE_UNIVERSE_15M_WITH_30M_BREADTH"},metrics:{phase:"BREADTH_V3"}});return json({ok:true,job_id:job.id,total_markets:markets.length,grid_length:gridLength,lookback_days:lookback});}
async function breadthShardV3(body:any){const job=await loadJob(String(body.job_id||""));if(job.revision!==V3_REVISION)throw new Error("v3 revision mismatch");const shardCount=Math.max(1,Math.round(finite(body.shard_count,job.config?.shard_count||25))),shard=Math.round(finite(body.shard_index,-1));if(shard<0||shard>=shardCount)throw new Error("bad shard");const markets=(job.config.markets as string[]).filter((_:string,i:number)=>i%shardCount===shard),start=Date.parse(job.window_start),end=Date.parse(job.window_end),gridStart=finite(job.config.grid_start_ms),N=finite(job.config.grid_length);const valid30=new Array(N).fill(0),pos30=new Array(N).fill(0),sum30=new Array(N).fill(0),valid6=new Array(N).fill(0),pos6=new Array(N).fill(0),sum6=new Array(N).fill(0),valid24=new Array(N).fill(0),pos24=new Array(N).fill(0),sum24=new Array(N).fill(0);let success=0,failed=0;
  const fetched=await mapConcurrent(markets,4,async market=>{try{return {market,ok:true as const,b:await bars(market,start,end)}}catch(e){return {market,ok:false as const,error:e instanceof Error?e.message:String(e)}}});
  for(const f of fetched){if(!f.ok){failed++;continue;}success++;const m=new Map<number,number>();for(const x of f.b)m.set(x.time,x.close);for(const x of f.b){const idx=Math.round((x.time-gridStart)/BAR_MS);if(idx<0||idx>=N)continue;const c30=m.get(x.time-2*BAR_MS),c6=m.get(x.time-24*BAR_MS),c24=m.get(x.time-96*BAR_MS);if(c30&&c30>0){const z=x.close/c30-1;valid30[idx]++;if(z>0)pos30[idx]++;sum30[idx]+=Math.max(-.10,Math.min(.10,z));}if(c6&&c6>0){const z=x.close/c6-1;valid6[idx]++;if(z>0)pos6[idx]++;sum6[idx]+=Math.max(-.20,Math.min(.20,z));}if(c24&&c24>0){const z=x.close/c24-1;valid24[idx]++;if(z>0)pos24[idx]++;sum24[idx]+=Math.max(-.20,Math.min(.20,z));}}}
  await upsertRows("v2_research_market_results",[v3BreadthRow(job,shard,{shard_count:shardCount,success,failed,valid30,pos30,sum30,valid6,pos6,sum6,valid24,pos24,sum24})],"job_id,market,config_key,split");return json({ok:true,job_id:job.id,shard,markets:markets.length,success,failed});}
async function finalizeV3(body:any){const job=await loadJob(String(body.job_id||""));if(job.revision!==V3_REVISION)throw new Error("v3 revision mismatch");const rows=await rest(`v2_research_market_results?job_id=eq.${encodeURIComponent(job.id)}&config_key=eq.BREADTH_SHARD_V3&select=market,parameters&limit=100`),shardCount=finite(job.config.shard_count,25);if((rows||[]).length<shardCount)throw new Error(`v3 breadth incomplete ${(rows||[]).length}/${shardCount}`);const N=finite(job.config.grid_length),gridStart=finite(job.config.grid_start_ms),valid30=new Array(N).fill(0),pos30=new Array(N).fill(0),sum30=new Array(N).fill(0),valid6=new Array(N).fill(0),pos6=new Array(N).fill(0),sum6=new Array(N).fill(0),valid24=new Array(N).fill(0),pos24=new Array(N).fill(0),sum24=new Array(N).fill(0);for(const row of rows){const p=row.parameters||{};for(let i=0;i<N;i++){valid30[i]+=finite(p.valid30?.[i]);pos30[i]+=finite(p.pos30?.[i]);sum30[i]+=finite(p.sum30?.[i]);valid6[i]+=finite(p.valid6?.[i]);pos6[i]+=finite(p.pos6?.[i]);sum6[i]+=finite(p.sum6?.[i]);valid24[i]+=finite(p.valid24?.[i]);pos24[i]+=finite(p.pos24?.[i]);sum24[i]+=finite(p.sum24?.[i]);}}
  const btcBars=await bars("BTCUSDT",Date.parse(job.window_start),Date.parse(job.window_end)),bm=new Map<number,number>();for(const b of btcBars)bm.set(b.time,b.close);const rawB=new Array(N).fill(false),rawS=new Array(N).fill(false),codes=new Array(N).fill("U"),breadth30=new Array(N).fill(NaN),mean30=new Array(N).fill(NaN),btc24=new Array(N).fill(NaN),total=finite(job.total_markets);
  for(let i=0;i<N;i++){const t=gridStart+i*BAR_MS;breadth30[i]=valid30[i]?pos30[i]/valid30[i]:NaN;mean30[i]=valid30[i]?sum30[i]/valid30[i]:NaN;const now=bm.get(t),p6=bm.get(t-24*BAR_MS),p24=bm.get(t-96*BAR_MS);if(now&&p24)btc24[i]=now/p24-1;if(valid24[i]<Math.max(50,total*.25)||!now||!p6||!p24)continue;const b6=valid6[i]?pos6[i]/valid6[i]:0,b24=pos24[i]/valid24[i],mean24=sum24[i]/valid24[i],r6=now/p6-1,r24=now/p24-1;rawB[i]=b24>=.58&&b6>=.55&&mean24>0&&r24>0&&r6>-.01;rawS[i]=b24<=.42&&b6<=.45&&mean24<0&&r24<0&&r6<.01;let cb=0,cs=0;for(let j=Math.max(0,i-3);j<=i;j++){if(rawB[j])cb++;if(rawS[j])cs++;}codes[i]=cb>=3?"B":cs>=3?"S":"R";}
  const round4=(x:number)=>Number.isFinite(x)?Math.round(x*10000)/10000:null;const split1=gridStart+Math.floor(N*.60)*BAR_MS,split2=gridStart+Math.floor(N*.80)*BAR_MS,counts={BULL:codes.filter(x=>x==="B").length,RANGE:codes.filter(x=>x==="R").length,BEAR:codes.filter(x=>x==="S").length,UNKNOWN:codes.filter(x=>x==="U").length};await patchJob(job.id,{status:"RUNNING",started_at:job.started_at||new Date().toISOString(),metrics:{phase:"BACKTEST_V3",grid_start_ms:gridStart,grid_length:N,regime_codes:codes.join(""),regime_counts:counts,breadth30:breadth30.map(round4),mean30:mean30.map(round4),btc24:btc24.map(round4),split1_time_ms:split1,split2_time_ms:split2,breadth_shards:rows.length,finalized_at:new Date().toISOString()}});return json({ok:true,job_id:job.id,regime_counts:counts,train_end:new Date(split1).toISOString(),validation_end:new Date(split2).toISOString()});}
async function backtestShardV3(body:any){const job=await loadJob(String(body.job_id||""));if(job.revision!==V3_REVISION)throw new Error("v3 revision mismatch");if(!job.metrics?.breadth30)throw new Error("finalize_v3 first");const shardCount=Math.max(1,Math.round(finite(body.shard_count,job.config?.shard_count||25))),shard=Math.round(finite(body.shard_index,-1));if(shard<0||shard>=shardCount)throw new Error("bad shard");const markets=(job.config.markets as string[]).filter((_:string,i:number)=>i%shardCount===shard),start=Date.parse(job.window_start),end=Date.parse(job.window_end);const fetched=await mapConcurrent(markets,4,async market=>{try{return {market,ok:true as const,b:await bars(market,start,end)}}catch(e){return {market,ok:false as const,error:e instanceof Error?e.message:String(e)}}});const rows:any[]=[];let success=0,failed=0;for(const f of fetched){if(!f.ok||f.b.length<300){failed++;continue;}success++;const p=prepare(f.b);for(const c of v3Candidates()){const sim=simulateV3(p,job.metrics,c);for(const split of ["TRAIN","VALIDATION","TEST"] as V3Split[])rows.push(v3MetricRow(job,f.market,c,split,summarize(sim[split]),p.length,p[0]?.time||0,p.at(-1)?.time||0));}}if(rows.length)await upsertRows("v2_research_market_results",rows,"job_id,market,config_key,split");return json({ok:true,job_id:job.id,shard,markets:markets.length,success,failed,result_rows:rows.length});}
async function completeV3(body:any){const job=await loadJob(String(body.job_id||""));const rows=await rest(`v2_research_market_results?job_id=eq.${encodeURIComponent(job.id)}&split=eq.TEST&config_key=neq.BREADTH_SHARD_V3&select=market&limit=20000`),unique=new Set((rows||[]).map((x:any)=>x.market));const updated=await patchJob(job.id,{status:"COMPLETE",processed_markets:unique.size,completed_at:new Date().toISOString(),metrics:{...(job.metrics||{}),phase:"COMPLETE_V3",completed_at:new Date().toISOString()}});return json({ok:true,job_id:job.id,status:updated.status,processed_markets:unique.size});}
