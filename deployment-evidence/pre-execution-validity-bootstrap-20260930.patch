+++ b/.github/workflows/pre-execution-validity-release-20260930.yml
@@ -0,0 +1,196 @@
+name: Pre-execution BUY validity production release
+on:
+  workflow_dispatch:
+  push:
+    branches: [main]
+    paths: [deployment-evidence/pre-execution-validity-release-20260930.json]
+permissions:
+  contents: read
+concurrency:
+  group: deploy-v10-lane-executor
+  cancel-in-progress: false
+jobs:
+  release:
+    runs-on: ubuntu-latest
+    timeout-minutes: 80
+    steps:
+      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
+        with:
+          ref: ${{ github.sha }}
+          fetch-depth: 0
+          persist-credentials: false
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+      - uses: denoland/setup-deno@v2
+        with:
+          deno-version: v2.5.6
+      - name: Verify scope, MOVR replay, and full regression
+        shell: bash
+        run: |
+          set -euo pipefail
+          mkdir -p release-evidence "$RUNNER_TEMP/pre-execution-pglite"
+          request=deployment-evidence/pre-execution-validity-release-20260930.json
+          baseline=$(node -p "require('./$request').baseline_main")
+          git merge-base --is-ancestor "$baseline" HEAD
+          git diff --check
+          git diff --quiet "$baseline" HEAD -- \
+            supabase/functions/_shared/gpt-final-decision/api.mjs \
+            supabase/functions/_shared/gpt-final-decision/deepseek.mjs \
+            supabase/functions/_shared/gpt-final-decision/dual.mjs \
+            supabase/functions/_shared/leader-momentum-v17.mjs \
+            supabase/functions/_shared/leader-exit-review.mjs \
+            supabase/functions/_shared/leader-slot-sizing.mjs \
+            supabase/functions/_shared/leader-native-protection.mjs \
+            supabase/functions/_shared/leader-entry-protection.mjs \
+            supabase/functions/_shared/leader-entry-settlement.mjs \
+            supabase/functions/_shared/leader-exit-settlement.mjs
+          node -e 'const r=require("./deployment-evidence/pre-execution-validity-release-20260930.json");if(r.release_scope!=="PRE_EXECUTION_STALE_BUY_ONLY"||r.validation_orders||r.model_change||r.strategy_change||r.leverage_change||r.slot_change||r.stop_change)throw Error("RELEASE_SCOPE");'
+          npm install --prefix "$RUNNER_TEMP/pre-execution-pglite" --ignore-scripts --no-audit --no-fund @electric-sql/pglite@0.3.14 >/dev/null
+          export PGLITE_MODULE="$RUNNER_TEMP/pre-execution-pglite/node_modules/@electric-sql/pglite/dist/index.js"
+          node ops/dynamic-flow/run-tests.mjs > release-evidence/node-tests.tap
+          deno check supabase/functions/v10-lane-executor/index.ts \
+            supabase/functions/_shared/gpt-final-decision/pre-execution-validity.mjs \
+            supabase/functions/v10-lane-executor/gpt-final-recheck-adapter.mjs
+          deno task test > release-evidence/deno-tests.txt
+          node --test tests/pre-execution-validity.test.mjs > release-evidence/movr-and-validity.tap
+      - uses: supabase/setup-cli@3c2f5e2ae34c34e428e8e206e2c4d21fa2d20fbf
+        with:
+          version: 2.109.1
+      - name: Snapshot production and wait for a safe deploy boundary
+        shell: bash
+        env:
+          SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}
+          SUPABASE_PROJECT_REF: ${{ secrets.SUPABASE_PROJECT_REF }}
+          SUPABASE_DB_URL: ${{ secrets.SUPABASE_DB_URL }}
+        run: |
+          set -euo pipefail
+          test "$SUPABASE_PROJECT_REF" = etaajwpernzrcdrifdnw
+          supabase functions list --project-ref "$SUPABASE_PROJECT_REF" --output json > release-evidence/functions-before.json
+          node --input-type=module <<'NODE'
+          import fs from 'node:fs';let rows=JSON.parse(fs.readFileSync('release-evidence/functions-before.json'));
+          rows=rows.functions??rows;const f=rows.find(x=>x.slug==='v10-lane-executor');
+          if(!f||f.status!=='ACTIVE'||f.verify_jwt!==false)throw Error('EXECUTOR_BASELINE');
+          fs.writeFileSync('release-evidence/version-before.txt',String(f.version)+'\n');
+          NODE
+          psql "$SUPABASE_DB_URL" -XAt --set=ON_ERROR_STOP=1 -c \
+            "select jsonb_build_object('mode',mode,'pause_new_entries',pause_new_entries,'withdrawal_mode',withdrawal_mode,'manual_intervention_required',manual_intervention_required,'allocation',binance_futures_allocation_usdt,'leverage',binance_futures_leverage,'max_positions',max_open_positions_per_exchange) from public.trading_settings where id=1" \
+            > release-evidence/settings-before.json
+          for i in $(seq 1 24); do
+            pending=$(psql "$SUPABASE_DB_URL" -XAt --set=ON_ERROR_STOP=1 -c \
+              "select count(*) from public.v11_long_regime_orders where state in ('PLANNED','DISPATCHED','RECONCILIATION_PENDING')")
+            test "$pending" = 0 && break
+            test "$i" -lt 24 || { echo "pending order boundary=$pending"; exit 1; }
+            sleep 5
+          done
+          psql "$SUPABASE_DB_URL" -XAt --set=ON_ERROR_STOP=1 -c \
+            "select to_char(clock_timestamp() at time zone 'UTC','YYYY-MM-DD\"T\"HH24:MI:SS.MS')||'Z'" \
+            > release-evidence/deploy-started-at.txt
+      - name: Deploy only v10-lane-executor
+        shell: bash
+        env:
+          SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}
+          SUPABASE_PROJECT_REF: ${{ secrets.SUPABASE_PROJECT_REF }}
+        run: |
+          set -euo pipefail
+          supabase functions deploy v10-lane-executor --project-ref "$SUPABASE_PROJECT_REF" --no-verify-jwt --use-api
+          echo "$GITHUB_SHA" > release-evidence/source-sha.txt
+      - name: Verify deployed bundle, settings, and runtime health
+        shell: bash
+        env:
+          SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}
+          SUPABASE_PROJECT_REF: ${{ secrets.SUPABASE_PROJECT_REF }}
+          SUPABASE_DB_URL: ${{ secrets.SUPABASE_DB_URL }}
+        run: |
+          set -euo pipefail
+          for i in $(seq 1 24); do
+            supabase functions list --project-ref "$SUPABASE_PROJECT_REF" --output json > release-evidence/functions-after.json
+            if node --input-type=module <<'NODE'
+          import fs from 'node:fs';let rows=JSON.parse(fs.readFileSync('release-evidence/functions-after.json'));
+          rows=rows.functions??rows;const f=rows.find(x=>x.slug==='v10-lane-executor'),before=Number(fs.readFileSync('release-evidence/version-before.txt'));
+          process.exit(f&&f.status==='ACTIVE'&&f.verify_jwt===false&&Number(f.version)===before+1?0:1);
+          NODE
+            then break; fi
+            test "$i" -lt 24 || exit 1
+            sleep 5
+          done
+          psql "$SUPABASE_DB_URL" -XAt --set=ON_ERROR_STOP=1 -c \
+            "select to_char(clock_timestamp() at time zone 'UTC','YYYY-MM-DD\"T\"HH24:MI:SS.MS')||'Z'" \
+            > release-evidence/deployed-at.txt
+          mkdir -p release-evidence/download-executor
+          supabase functions download v10-lane-executor --project-ref "$SUPABASE_PROJECT_REF" --use-api --workdir "$PWD/release-evidence/download-executor"
+          node ops/gpt-final-review/verify-bundle-parity.mjs release-evidence/download-executor . v10-lane-executor > release-evidence/bundle-parity.json
+          psql "$SUPABASE_DB_URL" -XAt --set=ON_ERROR_STOP=1 -c \
+            "select jsonb_build_object('mode',mode,'pause_new_entries',pause_new_entries,'withdrawal_mode',withdrawal_mode,'manual_intervention_required',manual_intervention_required,'allocation',binance_futures_allocation_usdt,'leverage',binance_futures_leverage,'max_positions',max_open_positions_per_exchange) from public.trading_settings where id=1" \
+            > release-evidence/settings-after.json
+          cmp release-evidence/settings-before.json release-evidence/settings-after.json
+          token=$(psql "$SUPABASE_DB_URL" -XAt --set=ON_ERROR_STOP=1 -c "select token from public.edge_internal_tokens where name='v10-lane-executor'")
+          curl -fsS --max-time 25 -H 'content-type: application/json' -H "x-v10-executor-token: $token" \
+            -d '{"mode":"ops-readiness"}' "https://$SUPABASE_PROJECT_REF.supabase.co/functions/v1/v10-lane-executor" \
+            > release-evidence/ops-readiness.json
+          node -e 'const r=require("./release-evidence/ops-readiness.json");if(!r.ok||!r.binance.positionsComplete||!r.binance.openOrdersComplete)throw Error("READINESS_FAILED")'
+          for i in $(seq 1 36); do
+            psql "$SUPABASE_DB_URL" -XAt --set=ON_ERROR_STOP=1 -c \
+              "select jsonb_build_object('completed_at',last_cycle_completed_at,'circuit_open',circuit_open,'last_error',last_error) from public.v11_long_regime_runtime where singleton and last_cycle_completed_at>='$(cat release-evidence/deployed-at.txt)'::timestamptz and circuit_open=false and coalesce(last_error,'')=''" \
+              > release-evidence/runtime-cycle.json
+            test -s release-evidence/runtime-cycle.json && break
+            test "$i" -lt 36 || exit 1
+            sleep 5
+          done
+      - name: Observe one naturally occurring GPT BUY validity check
+        shell: bash
+        env:
+          SUPABASE_DB_URL: ${{ secrets.SUPABASE_DB_URL }}
+        run: |
+          set -euo pipefail
+          deployed=$(cat release-evidence/deployed-at.txt)
+          for i in $(seq 1 60); do
+            psql "$SUPABASE_DB_URL" -XAt --set=ON_ERROR_STOP=1 -c "with d as (
+              select decided_at,reason,details from public.v11_long_regime_decisions
+              where decided_at>='$deployed'::timestamptz and details->>'stage'='PRE_EXECUTION_VALIDITY_CHECK'
+              order by decided_at desc limit 1)
+              select jsonb_build_object('decided_at',d.decided_at,'signal_id',d.details->>'signalId','symbol',d.details->>'symbol',
+                'reason',d.reason,'latest_capture_hash',d.details#>>'{validity,latest_capture_hash}',
+                'telemetry',d.details->'clockExecutionTelemetry','order',(
+                  select jsonb_build_object('state',o.state,'created_at',o.created_at,
+                    'order_sent_at',coalesce(o.response_payload#>>'{v22EntryFinality,clockExecutionTelemetry,order_sent_at}',o.response_payload#>>'{v22EntryFinality,sentAt}',o.response_payload#>>'{clockExecutionTelemetry,order_sent_at}'),
+                    'fill_at',coalesce(o.response_payload#>>'{v22EntryFinality,clockExecutionTelemetry,fill_at}',o.response_payload#>>'{clockExecutionTelemetry,fill_at}'))
+                  from public.v11_long_regime_orders o where o.signal_id=(d.details->>'signalId')::uuid and o.created_at>='$deployed'::timestamptz
+                  order by o.created_at desc limit 1)) from d" > release-evidence/natural-candidate.json
+            test -s release-evidence/natural-candidate.json && break
+            test "$i" -lt 60 || { echo 'NO_NATURAL_GPT_BUY_VALIDITY_CHECK_WITHIN_60_MINUTES'; exit 1; }
+            sleep 60
+          done
+          node --input-type=module <<'NODE'
+          import fs from 'node:fs';const x=JSON.parse(fs.readFileSync('release-evidence/natural-candidate.json'));
+          const t=x.telemetry??{},required=['gpt_buy_completed_at','pre_execution_check_at','decision_age_ms','original_snapshot_at',
+            'latest_snapshot_at','new_buckets_since_buy','price_drift_bps','spread_delta_bps','slippage_delta_bps','validity_result',
+            'validity_reasons','gpt_recheck_attempted','gpt_recheck_result','gpt_recheck_latency_ms','order_sent_at','fill_at'];
+          for(const k of required)if(!Object.hasOwn(t,k))throw Error('MISSING_TELEMETRY:'+k);
+          if(!['VALID','UNCERTAIN','INVALID'].includes(t.validity_result))throw Error('VALIDITY_RESULT');
+          if(!(Number.isFinite(t.decision_age_ms)&&Number.isInteger(t.new_buckets_since_buy)&&x.latest_capture_hash))throw Error('FRESHNESS_EVIDENCE');
+          if(t.validity_result==='VALID'&&t.gpt_recheck_attempted!==false)throw Error('VALID_CALLED_GPT');
+          if(t.validity_result==='INVALID'&&t.gpt_recheck_attempted!==false)throw Error('INVALID_CALLED_GPT');
+          fs.writeFileSync('release-evidence/production-verification.json',JSON.stringify(x,null,2)+'\n');
+          NODE
+          psql "$SUPABASE_DB_URL" -XAt --set=ON_ERROR_STOP=1 -c "select jsonb_build_object(
+            'samples',count(*),'p95_pre_execution_check_latency_ms',percentile_cont(.95) within group(order by (details#>>'{clockExecutionTelemetry,pre_execution_check_latency_ms}')::numeric))
+            from public.v11_long_regime_decisions where decided_at>='$deployed'::timestamptz
+              and details->>'stage'='PRE_EXECUTION_VALIDITY_CHECK' and details#>>'{clockExecutionTelemetry,pre_execution_check_latency_ms}' is not null" \
+            > release-evidence/latency-p95.json
+          echo 'PRODUCTION_VERIFICATION'
+          cat release-evidence/production-verification.json
+          echo 'PRE_EXECUTION_LATENCY'
+          cat release-evidence/latency-p95.json
+          echo 'EXECUTOR_VERSION'
+          node --input-type=module <<'NODE'
+          import fs from 'node:fs';let rows=JSON.parse(fs.readFileSync('release-evidence/functions-after.json'));
+          rows=rows.functions??rows;const f=rows.find(x=>x.slug==='v10-lane-executor');
+          console.log(JSON.stringify({version_before:Number(fs.readFileSync('release-evidence/version-before.txt')),version_after:Number(f.version),status:f.status,verify_jwt:f.verify_jwt}));
+          NODE
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: pre-execution-validity-production-release
+          path: release-evidence
+          retention-days: 30
